<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee" version="6.0">
 <display-name>Spam Blocker for Blogs</display-name>
 <servlet>
  <servlet-name>jsp</servlet-name><servlet-class>org.apache.jasper.servlet.JspServlet</servlet-class>
  <init-param><param-name>compilerSourceVM</param-name><param-value>17</param-value></init-param>
  <init-param><param-name>compilerTargetVM</param-name><param-value>17</param-value></init-param>
 </servlet>
 <servlet>
  <servlet-name>app</servlet-name><servlet-class>blog.AppServlet</servlet-class><load-on-startup>1</load-on-startup>
  <multipart-config><max-file-size>2097152</max-file-size><max-request-size>2500000</max-request-size><file-size-threshold>0</file-size-threshold></multipart-config>
 </servlet>
 <servlet-mapping><servlet-name>app</servlet-name><url-pattern>/app/*</url-pattern></servlet-mapping>
 <session-config><session-timeout>30</session-timeout><cookie-config><http-only>true</http-only></cookie-config><tracking-mode>COOKIE</tracking-mode></session-config>
 <welcome-file-list><welcome-file>index.html</welcome-file></welcome-file-list>
</web-app>
